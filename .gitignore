# datasets are never committed: CGMacros is CC BY-NC-SA and must be fetched by the user
/data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
/dist/
results/**/*.npz

# design-mock fonts are copied locally from the environment; the build vendors them with their licence
/docs/specs/m4-mocks/fonts/

# the local bundle holds per-reading arrays of real patients (rule 6)
/artifacts/

# editor and agent config
.claude/
.agents/
.gemini/
CLAUDE.md
GEMINI.md
AGENTS.md
skills-lock.json
scratch/

